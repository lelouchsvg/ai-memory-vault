{
  "name": "wholesale-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "os:start": "bash scripts/dev-up.sh --stay-alive",
    "os:start:production": "CONTROL_TOWER_WEB_MODE=production bash scripts/dev-up.sh --stay-alive",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "tsx scripts/database.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "owner:create": "tsx --env-file=.env.local scripts/create-owner.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "lint": "eslint .",
    "format:check": "prettier --check src scripts tests docs"
  },
  "dependencies": {
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

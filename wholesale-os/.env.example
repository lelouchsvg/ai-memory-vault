# Use a dedicated PostgreSQL database. For managed databases use verified TLS.
DATABASE_URL=postgresql://wholesale:CHANGE_ME@127.0.0.1:54329/wholesale
# Set COOKIE_SECURE=true behind HTTPS in deployed environments.
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# Only enable demo sign-in on an isolated development deployment.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=owner@demo.local
DEMO_PASSWORD=CHANGE_ME
# Optional one-time account creation; run npm run owner:create.
# OWNER_EMAIL=
# OWNER_PASSWORD=
# OWNER_ROLE=OWNER
# Optional structured AI skill planner. Local skills work without these.
# OS_AI_PROVIDER=openai
# OS_AI_MODEL=<a model available to your account with structured output support>
# OS_AI_API_KEY=<set securely; never commit>
# Allow api.openai.com in cloud environment settings before enabling this provider.

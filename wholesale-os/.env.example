# Use a dedicated PostgreSQL database. For managed databases use verified TLS.
DATABASE_URL=postgresql://wholesale:CHANGE_ME@127.0.0.1:54329/wholesale
# Set COOKIE_SECURE=true behind HTTPS in deployed environments.
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# Only enable demo sign-in on an isolated development deployment.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=owner@demo.local
DEMO_PASSWORD=CHANGE_ME
# Optional one-time account creation; run npm run owner:create.
# OWNER_EMAIL=
# OWNER_PASSWORD=
# OWNER_ROLE=OWNER
